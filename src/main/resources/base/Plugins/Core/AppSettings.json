{
	"archive_handlers": {
		".zip": "zip://",
		".zipx": "zip://",
		".jar": "zip://",
		".xpi": "zip://",
		".7z": "7z://",
		".tar": "tar://"
	},
	"terminal": {
		"args": "start C:\\Windows\\System32\\cmd.exe", "shell": true, "cwd": "{curr_dir}"
	},
	"native_file_manager": {
		"args": ["start", "explorer", "{curr_dir}"], "shell": true
	}
}